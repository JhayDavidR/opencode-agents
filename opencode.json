{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*.php": "deny",
      "*.js": "deny",
      "*.htm": "deny",
      "*.inc": "deny",
      "**/.git/**": "deny"
    },
    "bash": {
      "git *": "deny",
      "* git *": "deny",
      "*;git *": "deny",
      "*&git *": "deny",
      "*|git *": "deny",
      "git.exe *": "deny",
      "* git.exe *": "deny",
      "gh *": "deny",
      "* gh *": "deny"
    },
    "external_directory": {
      "*/.opencode/tmp/*": "allow",
      "*\\.opencode\\tmp\\*": "allow"
    }
  }
}
